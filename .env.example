# Copia este archivo a .env y revisa los valores. .env NUNCA se sube a GitHub.
# La API no arranca si falta alguna de las tres primeras variables.

# Base SQLite con el catálogo CPC (en Docker vive dentro de la imagen).
CPCMINI_DATABASE_URL=sqlite:////app/data/cpcmini.db
# Carpeta del modelo empaquetado (cpcmini package <modelo>).
CPCMINI_MODEL_DIR=/app/artifacts/serving
# Orígenes permitidos por CORS, separados por coma. Nunca "*".
CPCMINI_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Opcionales
CPCMINI_RATE_LIMIT_PER_MINUTE=60
CPCMINI_DOCS_ENABLED=true
# true sólo detrás del proxy de confianza (nginx de docker compose), que fija X-Real-IP.
CPCMINI_TRUST_PROXY_HEADERS=true

# Puertos locales de docker compose
WEB_PORT=8080

# Sólo para publicar dataset/modelo en Hugging Face (no lo usa la app). Déjalo vacío aquí.
HF_TOKEN=
